---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
    preloadVideos?: string[];
}

const { title, description = "Chisel - Text-first tools for shaping information.", preloadVideos = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;700&display=swap" rel="stylesheet">
        {preloadVideos.map(video => (
            <link rel="preload" as="video" href={video} type="video/webm" />
        ))}
	</head>
	<body class="bg-[#0D0D0D] text-[#EDEDED] font-mono selection:bg-blue-500/30 relative min-h-screen overflow-x-hidden">
		<!-- Nebula Glows -->
		<div class="fixed top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-[#4DA3FF] blur-[120px] opacity-[0.1] z-[-2]"></div>
		<div class="fixed top-[20%] right-[-5%] w-[40%] h-[40%] rounded-full bg-[#BB6BD9] blur-[120px] opacity-[0.05] z-[-2]"></div>
		<div class="fixed bottom-[10%] left-[5%] w-[45%] h-[45%] rounded-full bg-[#4DA3FF] blur-[120px] opacity-[0.07] z-[-2]"></div>
		<div class="fixed bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-[#56CCF2] blur-[120px] opacity-[0.08] z-[-2]"></div>

		<!-- Masked Grid Background -->
		<div class="fixed inset-0 z-[-1] pointer-events-none opacity-[0.15]" style="mask-image: radial-gradient(circle at center, black, transparent 80%);">
			<div class="absolute inset-0 h-full w-full bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
		</div>
		
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--accent-blue: #4DA3FF;
		--accent-green: #6EEB83;
		--accent-yellow: #F2C94C;
		--accent-red: #EB5757;
		--accent-magenta: #BB6BD9;
		--accent-cyan: #56CCF2;
	}

	body {
		font-family: 'JetBrains Mono', monospace;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: 'Inter', sans-serif;
	}
</style>
