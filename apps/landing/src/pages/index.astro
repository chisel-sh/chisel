---
import Layout from "../layouts/Layout.astro";
import { HeroTerminal } from "../components/HeroTerminal";
import MarqueeBanner from "../components/MarqueeBanner.astro";
import { DualModeVideo } from "../components/DualModeVideo";

const version = import.meta.env.CHISEL_VERSION;
---

<Layout
    title="Chisel | The project brain for founders building with AI agents."
    preloadVideos={[
        "/assets/docs_human.webm",
        "/assets/docs_machine.webm",
    ]}
>
    <MarqueeBanner />
    <nav class="max-w-6xl mx-auto px-4 py-6 flex justify-end">
        <a href="/docs" class="text-sm font-mono text-gray-400 hover:text-[#4DA3FF] transition-colors flex items-center gap-2 group">
            Documentation
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
    </nav>
    <main class="max-w-6xl mx-auto px-4 py-20 sm:py-32">
        <!-- Hero Section -->
        <section class="text-center mb-24">
            <div class="flex flex-col items-center justify-center mb-10">
                <h1
                    class="text-7xl sm:text-9xl font-extrabold tracking-tighter text-[#EDEDED] flex items-center justify-center drop-shadow-[0_0_30px_rgba(237,237,237,0.15)]"
                >
                    chisel<span
                        class="text-[#4DA3FF] ml-1 drop-shadow-[0_0_15px_rgba(77,163,255,0.5)]"
                        >_</span
                    >
                </h1>
            </div>
            <p
                class="text-xl sm:text-2xl text-gray-400 max-w-3xl mx-auto mb-10 font-mono"
            >
                <span class="text-[#4DA3FF]"
                    >Your codebase grows faster than your memory.</span
                ><br />
                Chisel keeps you the architect.
            </p>
            <p class="text-lg text-gray-300 max-w-2xl mx-auto mb-12">
                Structured specs and docs your LLM can actually use. Write once,
                query from anywhere. The project brain for solo founders and
                small teams building with AI agents.
            </p>

            <div class="max-w-md mx-auto mb-12">
                <form
                    name="hero-signup"
                    method="POST"
                    action="/success"
                    data-netlify="true"
                    class="flex flex-col sm:flex-row gap-3"
                >
                    <input type="hidden" name="form-name" value="hero-signup" />
                    <input
                        type="email"
                        name="email"
                        placeholder="your@email.com"
                        required
                        class="flex-grow px-4 py-3 bg-[#1A1A1A] border border-gray-800 rounded text-[#EDEDED] focus:outline-none focus:border-[#4DA3FF] font-mono text-sm"
                    />
                    <button
                        type="submit"
                        class="px-6 py-3 bg-[#EDEDED] text-[#0D0D0D] font-bold rounded hover:bg-[#4DA3FF] transition-colors whitespace-nowrap"
                    >
                        Subscribe for Updates
                    </button>
                </form>
                <p class="text-xs text-gray-400 mt-4 font-mono">
                    We are currently in public alpha. Sign up for release notes.
                </p>
            </div>

            <!-- Install Teaser -->
            <div class="max-w-xl mx-auto mb-20">
                <div
                    class="bg-[#050505] border border-gray-800 rounded-lg p-1.5 pl-4 flex items-center justify-between font-mono text-sm group"
                >
                    <code
                        class="text-gray-400 whitespace-nowrap overflow-x-auto py-2"
                    >
                        <span class="text-[#4DA3FF]">$</span> curl -sL https://install.chisel.build
                        | sh
                    </code>
                    <div class="flex items-center gap-3">
                        <button
                            id="copy-install"
                            class="p-2 hover:bg-gray-900 rounded-md transition-colors text-gray-500 hover:text-[#EDEDED]"
                            title="Copy to clipboard"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    width="14"
                                    height="14"
                                    x="8"
                                    y="8"
                                    rx="2"
                                    ry="2"></rect><path
                                    d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                                ></path></svg
                            >
                        </button>
                        <span
                            class="text-[10px] text-blue-400 uppercase tracking-widest font-bold pr-3 border-l border-gray-800 pl-3 hidden sm:inline"
                            >Public Alpha</span
                        >
                    </div>
                </div>
            </div>

            <script>
                const copyBtn = document.getElementById("copy-install");
                copyBtn?.addEventListener("click", () => {
                    const code = "curl -sL https://install.chisel.build | sh";
                    navigator.clipboard.writeText(code);

                    // Visual feedback
                    const originalIcon = copyBtn.innerHTML;
                    copyBtn.innerHTML =
                        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6EEB83" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
                    setTimeout(() => {
                        copyBtn.innerHTML = originalIcon;
                    }, 2000);
                });
            </script>

            <div class="max-w-4xl mx-auto">
                <HeroTerminal client:load />
            </div>
        </section>

        <!-- The Problem -->
        <section class="max-w-3xl mx-auto mb-32 text-center">
            <h2 class="text-3xl font-bold mb-8 text-[#EDEDED]">
                The context problem
            </h2>
            <p class="text-gray-400 leading-relaxed text-lg mb-6">
                Solo founders and small teams using LLM agents ship fast &mdash; faster than
                any human can track. Six months in, the codebase has outgrown your ability
                to hold it in your head. Every new agent session starts from scratch.
                Decisions are made twice. Architecture drifts from intent.
            </p>
            <p class="text-gray-300 leading-relaxed text-lg">
                Chisel is the infrastructure that preserves your reasoning. Specs capture
                intent, constraints, and decisions. Docs preserve permanent knowledge.
                Both are structured so your LLM tools can read them as context when they need it.
            </p>
        </section>

        <!-- The Primitives -->
        <section class="max-w-4xl mx-auto mb-32">
            <div
                class="bg-[#1A1A1A]/50 border border-gray-800 rounded-2xl p-8 backdrop-blur-sm"
            >
                <h2
                    class="text-xl font-bold mb-6 text-[#EDEDED] flex items-center gap-2"
                >
                    <span
                        class="w-2 h-2 bg-green-500 rounded-full animate-pulse"
                    ></span>
                    Available Now
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                    <div class="space-y-2">
                        <div
                            class="text-xs font-mono text-[#BB6BD9] uppercase tracking-widest font-bold"
                        >
                            New
                        </div>
                        <h3 class="font-bold text-[#EDEDED]">Chisel Specs</h3>
                        <p class="text-sm text-gray-400">
                            Lifecycle-aware specs for active work. Draft &rarr; ready &rarr;
                            in-progress &rarr; shipped. The highest-value context artifact
                            for your LLM mid-implementation.
                        </p>
                    </div>
                    <div class="space-y-2 border-l-0 sm:border-l border-gray-800 pl-0 sm:pl-8">
                        <div
                            class="text-xs font-mono text-blue-400 uppercase tracking-widest font-bold"
                        >
                            Stable
                        </div>
                        <h3 class="font-bold text-[#EDEDED]">Chisel Docs</h3>
                        <p class="text-sm text-gray-400">
                            Permanent knowledge base with 3-pane TUI explorer,
                            SQLite full-text search, and structured machine mode output.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Product Detail Cards -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-32">
            <div class="space-y-6">
                <h3 class="text-2xl font-bold text-[#EDEDED]">Chisel Specs</h3>
                <p class="text-gray-400 leading-relaxed">
                    The artifact that lives between an idea and a shipped feature.
                    Captures intent, constraints, alternatives, and implementation
                    notes. Structured for both humans and LLM agents.
                </p>
                <div class="flex flex-wrap gap-2 pt-2">
                    <span
                        class="text-[10px] px-2 py-0.5 bg-[#BB6BD9]/10 border border-[#BB6BD9]/20 rounded text-[#BB6BD9] uppercase font-bold tracking-widest"
                        >Lifecycle</span
                    >
                    <span
                        class="text-[10px] px-2 py-0.5 bg-[#BB6BD9]/10 border border-[#BB6BD9]/20 rounded text-[#BB6BD9] uppercase font-bold tracking-widest"
                        >Machine Mode</span
                    >
                    <span
                        class="text-[10px] px-2 py-0.5 bg-[#BB6BD9]/10 border border-[#BB6BD9]/20 rounded text-[#BB6BD9] uppercase font-bold tracking-widest"
                        >Templates</span
                    >
                </div>
            </div>
            <div class="space-y-6">
                <h3 class="text-2xl font-bold text-[#EDEDED]">Chisel Docs</h3>
                <p class="text-gray-400 leading-relaxed">
                    A knowledge base that understands structure. Markdown-first.
                    Local SQLite index. AI-ready schemas. Your permanent project memory.
                </p>
                <div class="flex flex-wrap gap-2 pt-2">
                    <span
                        class="text-[10px] px-2 py-0.5 bg-blue-500/10 border border-blue-500/20 rounded text-blue-400 uppercase font-bold tracking-widest"
                        >Markdown</span
                    >
                    <span
                        class="text-[10px] px-2 py-0.5 bg-blue-500/10 border border-blue-500/20 rounded text-blue-400 uppercase font-bold tracking-widest"
                        >Local Index</span
                    >
                    <span
                        class="text-[10px] px-2 py-0.5 bg-blue-500/10 border border-blue-500/20 rounded text-blue-400 uppercase font-bold tracking-widest"
                        >RAG Ready</span
                    >
                </div>
            </div>
        </section>

        <!-- Comparison: Without vs With -->
        <section class="mb-32">
            <h2 class="text-3xl font-bold text-center mb-16 text-[#EDEDED]">
                Without Chisel vs. With Chisel
            </h2>

            <!-- Desktop Table -->
            <div
                class="hidden md:block max-w-4xl mx-auto overflow-hidden rounded-2xl border border-gray-800 bg-[#050505]"
            >
                <table class="w-full text-left text-sm border-collapse">
                    <thead>
                        <tr class="bg-[#1A1A1A]">
                            <th
                                class="p-4 font-bold text-[#EDEDED] border-b border-gray-800"
                                ></th
                            >
                            <th
                                class="p-4 font-bold text-gray-500 border-b border-gray-800"
                                >Without Chisel</th
                            >
                            <th
                                class="p-4 font-bold text-blue-400 border-b border-gray-800"
                                >With Chisel</th
                            >
                        </tr>
                    </thead>
                    <tbody class="text-gray-400">
                        <tr class="border-b border-gray-900 hover:bg-[#0D0D0D]">
                            <td class="p-4 border-r border-gray-900 font-medium"
                                >Decision memory</td
                            >
                            <td class="p-4 border-r border-gray-900"
                                >Lost in Slack threads and closed PRs</td
                            >
                            <td class="p-4 font-bold text-[#EDEDED]"
                                >Preserved in versioned specs alongside code</td
                            >
                        </tr>
                        <tr class="border-b border-gray-900 hover:bg-[#0D0D0D]">
                            <td class="p-4 border-r border-gray-900 font-medium"
                                >Agent context</td
                            >
                            <td class="p-4 border-r border-gray-900"
                                >Every session starts from scratch</td
                            >
                            <td class="p-4 font-bold text-[#EDEDED]"
                                >One command generates structured context</td
                            >
                        </tr>
                        <tr class="border-b border-gray-900 hover:bg-[#0D0D0D]">
                            <td class="p-4 border-r border-gray-900 font-medium"
                                >Spec lifecycle</td
                            >
                            <td class="p-4 border-r border-gray-900"
                                >Google Docs that go stale after shipping</td
                            >
                            <td class="p-4 font-bold text-[#EDEDED]"
                                >Draft &rarr; ready &rarr; in-progress &rarr; shipped &rarr; archived</td
                            >
                        </tr>
                        <tr class="hover:bg-[#0D0D0D]">
                            <td class="p-4 border-r border-gray-900 font-medium"
                                >Knowledge retrieval</td
                            >
                            <td class="p-4 border-r border-gray-900"
                                >Manual copy-paste from wikis</td
                            >
                            <td class="p-4 font-bold text-[#EDEDED]"
                                >Full-text search with machine mode output</td
                            >
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Mobile Cards -->
            <div class="grid grid-cols-1 gap-6 md:hidden">
                {
                    [
                        {
                            feature: "Decision Memory",
                            without: "Lost in Slack threads and closed PRs",
                            chisel: "Preserved in versioned specs alongside code",
                        },
                        {
                            feature: "Agent Context",
                            without: "Every session starts from scratch",
                            chisel: "One command generates structured context",
                        },
                        {
                            feature: "Spec Lifecycle",
                            without: "Google Docs that go stale after shipping",
                            chisel: "Draft \u2192 ready \u2192 in-progress \u2192 shipped",
                        },
                        {
                            feature: "Knowledge Retrieval",
                            without: "Manual copy-paste from wikis",
                            chisel: "Full-text search with machine mode output",
                        },
                    ].map((item) => (
                        <div class="bg-[#050505] border border-gray-800 rounded-xl p-6 space-y-4">
                            <div class="text-blue-400 font-mono text-xs uppercase tracking-widest font-bold">
                                {item.feature}
                            </div>
                            <div class="grid grid-cols-2 gap-4 pt-2">
                                <div class="space-y-1">
                                    <div class="text-[10px] text-gray-500 uppercase font-bold tracking-tighter">
                                        Without
                                    </div>
                                    <div class="text-sm text-gray-400">
                                        {item.without}
                                    </div>
                                </div>
                                <div class="space-y-1 border-l border-gray-900 pl-4">
                                    <div class="text-[10px] text-[#EDEDED] uppercase font-bold tracking-tighter">
                                        With Chisel
                                    </div>
                                    <div class="text-sm text-[#EDEDED] font-bold">
                                        {item.chisel}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- Human vs Machine Section -->
        <section class="mb-32">
            <h2
                class="text-3xl sm:text-4xl font-bold text-center mb-4 text-[#EDEDED]"
            >
                Built for humans. Structured for AI.
            </h2>
            <div class="max-w-2xl mx-auto text-center mb-16 space-y-4">
                <p class="text-gray-400 font-mono text-sm">
                    Every Chisel tool supports a mode optimized for LLM context
                    windows and parsing. Works with Claude Code, Cursor, Aider,
                    and any shell-capable agent.
                </p>
                <div
                    class="inline-block px-4 py-2 bg-blue-500/10 border border-blue-500/20 rounded-lg text-xs text-blue-300 font-mono"
                >
                    <b class="text-[#4DA3FF]">BYOLLM:</b> Chisel structures your knowledge.
                    You bring the model.
                </div>
            </div>

            <div class="space-y-20 max-w-4xl mx-auto">
                <!-- Docs Example -->
                <div class="space-y-6">
                    <div class="flex items-center gap-4">
                        <div class="h-px flex-grow bg-gray-900"></div>
                        <h3
                            class="text-sm font-mono text-gray-400 uppercase tracking-widest"
                        >
                            Chisel Docs
                        </h3>
                        <div class="h-px flex-grow bg-gray-900"></div>
                    </div>

                    <DualModeVideo
                        client:load
                        humanTitle="chisel docs"
                        machineTitle="chisel docs — machine"
                        humanVideo="/assets/docs_human.webm"
                        machineVideo="/assets/docs_machine.webm"
                    >
                        <div
                            slot="humanFooter"
                            class="flex gap-4 text-gray-400 text-[10px] font-mono"
                        >
                            <span><b class="text-[#EDEDED]">e</b>:edit</span>
                            <span><b class="text-[#EDEDED]">n</b>:new</span>
                            <span><b class="text-[#EDEDED]">Tab</b>:switch</span
                            >
                            <span class="ml-auto text-gray-400 italic"
                                >hjkl navigation</span
                            >
                        </div>
                    </DualModeVideo>
                </div>

                <!-- Workflow Example -->
                <div class="space-y-6">
                    <div class="flex items-center gap-4">
                        <div class="h-px flex-grow bg-gray-900"></div>
                        <h3
                            class="text-sm font-mono text-gray-400 uppercase tracking-widest"
                        >
                            The Workflow
                        </h3>
                        <div class="h-px flex-grow bg-gray-900"></div>
                    </div>

                    <div class="bg-[#050505] border border-gray-800 rounded-xl p-8 space-y-6 font-mono text-sm">
                        <div class="space-y-2">
                            <div class="text-gray-500"># Write a spec for your next feature</div>
                            <div><span class="text-[#4DA3FF]">$</span> chisel spec new "user authentication"</div>
                        </div>
                        <div class="space-y-2">
                            <div class="text-gray-500"># Implement with your LLM agent</div>
                            <div><span class="text-[#4DA3FF]">$</span> chisel context create "auth" | claude -p "implement this"</div>
                        </div>
                        <div class="space-y-2">
                            <div class="text-gray-500"># Mark shipped when done</div>
                            <div><span class="text-[#4DA3FF]">$</span> chisel spec status user-auth shipped</div>
                        </div>
                        <div class="text-gray-500 text-xs pt-2 border-t border-gray-900">
                            The spec now reflects what actually shipped. Six months later, you or your agent can find it.
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Technical Foundation / The Bones -->
        <section class="mb-32 py-20 border-y border-gray-900 relative">
            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 max-w-6xl mx-auto"
            >
                <div class="space-y-4">
                    <div class="text-[#4DA3FF] text-xl font-bold font-mono">
                        01. Architecture
                    </div>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        Written in <b class="text-[#EDEDED]">Rust</b> for near-zero
                        overhead. TUI response times under 10ms on massive datasets.
                        No Node.js or Python runtime required.
                    </p>
                </div>
                <div class="space-y-4">
                    <div class="text-[#4DA3FF] text-xl font-bold font-mono">
                        02. Storage
                    </div>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        Local-first <b class="text-[#EDEDED]">Markdown & YAML</b
                        > files. An internal <b class="text-[#EDEDED]"
                            >SQLite FTS5</b
                        > index provides instant full-text search.
                    </p>
                </div>
                <div class="space-y-4">
                    <div class="text-[#4DA3FF] text-xl font-bold font-mono">
                        03. License
                    </div>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        Chisel is <b class="text-[#EDEDED]">FSL-1.1</b>.
                        Free for non-competing use and converts to Apache 2.0
                        after 2 years.
                    </p>
                </div>
                <div class="space-y-4">
                    <div class="text-[#4DA3FF] text-xl font-bold font-mono">
                        04. Extensible
                    </div>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        Built to be extended. Use the <b class="text-[#EDEDED]"
                            >Machine Mode YAML</b
                        > output to pipe Chisel into scripts or AI agents.
                    </p>
                </div>
            </div>
        </section>

        <!-- Call to Action -->
        <section class="text-center py-20 border-t border-gray-900">
            <h2 class="text-4xl font-bold mb-8 text-[#EDEDED]">
                Start staying the architect.
            </h2>
            <p class="text-xl text-gray-300 mb-12">
                Chisel is in active development. Try the alpha today and keep your
                project's reasoning intact as it scales.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
                <a
                    href="/docs/welcome-to-chisel"
                    class="px-8 py-4 bg-[#EDEDED] text-[#0D0D0D] font-bold rounded-lg hover:bg-[#4DA3FF] transition-all transform hover:-translate-y-1 w-full sm:w-auto"
                >
                    View Documentation
                </a>
                <a
                    href="https://github.com/chisel-sh/chisel"
                    class="px-8 py-4 bg-transparent border border-gray-800 text-[#EDEDED] font-bold rounded-lg hover:border-[#4DA3FF] transition-all w-full sm:w-auto"
                >
                    View on GitHub
                </a>
            </div>
            <p class="text-gray-500 font-mono text-xs mt-12">
                v{version}-alpha &bull; FSL-1.1-Apache-2.0 Licensed
            </p>
        </section>
    </main>

    <footer
        class="py-12 border-t border-gray-900 text-center text-gray-400 text-sm"
    >
        <p>&copy; 2026 Chisel Tools. The project brain for builders.</p>
    </footer>
</Layout>
